    {"label": "ChinaTravel: 运行测试", "type": "process", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["-m", "pytest", "-q"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": [], "group": "test"}
  ]
